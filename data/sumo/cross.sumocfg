<!-- 
    Master configuration file for the SUMO sandbox simulation.
    Binds the generated network (.net.xml) and the traffic routes (.rou.xml).
-->
<configuration>
    <input>
        <net-file value="cross.net.xml"/>
        <route-files value="cross.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="0.1"/>
    </time>
    <gui_only>
        <gui-settings-file value="gui-settings.xml"/>
    </gui_only>
</configuration>